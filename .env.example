# Copy to .env and set your deployed HTTPS origin and OAuth provider settings.
PUBLIC_URL=https://receipts.example.com
# Exact issuer from your provider's OAuth/OIDC discovery document (including slash).
OAUTH_ISSUER=https://auth.example.com/
OAUTH_JWKS_URL=https://auth.example.com/.well-known/jwks.json
# Generate with: python3 -c 'import secrets; print(secrets.token_urlsafe(48))'
DOWNLOAD_SECRET=replace-with-a-random-secret-at-least-32-characters
DATABASE_PATH=/data/receipts.sqlite3
HOST=0.0.0.0
PORT=8000
